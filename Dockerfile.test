# Dockerfile for Linux-based kcov testing
#
# Compliant with [AGENTS.md](AGENTS.md)
#
# Purpose: Provides Linux environment for kcov coverage testing
# macOS has ptrace limitations that prevent kcov from working correctly
#
# Usage:
#   docker build -f Dockerfile.test -t pndcgn-test .
#   docker run --rm -v "$PWD:/workspace" -w /workspace pndcgn-test shellspec --kcov

FROM ubuntu:22.04

# Avoid interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    bash \
    sqlite3 \
    pandoc \
    git \
    curl \
    fzf \
    build-essential \
    cmake \
    binutils-dev \
    libcurl4-openssl-dev \
    zlib1g-dev \
    libdw-dev \
    libiberty-dev \
    libssl-dev \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install ShellSpec (not available in apt)
RUN curl -fsSL https://git.io/shellspec | sh -s -- --yes && \
    mv ~/.local/bin/shellspec /usr/local/bin/shellspec || \
    (mkdir -p /usr/local/bin && find ~/.local -name shellspec -exec cp {} /usr/local/bin/ \;)

# Install kcov (build from source - need v35+ for ShellSpec)
RUN git clone --depth=1 --branch v44 https://github.com/SimonKagstrom/kcov.git /tmp/kcov || \
    (git clone --depth=1 https://github.com/SimonKagstrom/kcov.git /tmp/kcov && \
     cd /tmp/kcov && \
     git fetch --tags && \
     git checkout v44 2>/dev/null || git checkout v40 2>/dev/null || git checkout v38 2>/dev/null || true) && \
    cd /tmp/kcov && \
    mkdir build && \
    cd build && \
    cmake .. && \
    make && \
    make install && \
    rm -rf /tmp/kcov

# Verify installations
RUN shellspec --version && kcov --version

# Set working directory
WORKDIR /workspace

# Default command: run tests with kcov
CMD ["shellspec", "--kcov"]
